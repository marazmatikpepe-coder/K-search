{
  "name": "k-search-browser",
  "version": "2.0.0",
  "description": "K-search — лёгкий браузер",
  "author": "K-search",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:setup": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.ksearch.browser",
    "productName": "K-search",
    "files": ["main.js", "preload.js", "tab-preload.js", "index.html", "ui.js", "search.html", "settings.html", "theme.js", "glass.css", "logo.png", "icon.png"],
    "win": { "icon": "build/icon.ico", "target": "nsis" },
    "portable": { "artifactName": "K-search-portable.exe" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "K-search-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
